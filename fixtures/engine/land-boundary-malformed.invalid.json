      "mutations": [
        {
          "operation": "replace",
          "path": "/schemaVersion",
          "value": "2.0.0"
        }
      ]
    },
    {
      "id": "deployment-profile-not-private",
      "expectedLayer": "schema",
      "expectedCode": "SCHEMA_INVALID",
