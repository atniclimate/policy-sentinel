{
  "fixtureFamilyVersion": "1.0.0",
  "baseFixture": "land-boundary.synthetic.valid.json",
  "cases": [
    {
      "id": "bad-boundary-id-pattern",
      "expectedLayer": "schema",
      "expectedCode": "SCHEMA_INVALID",
      "expectedPath": "$/boundaryId",
      "mutations": [
        {
          "operation": "replace",
          "path": "/boundaryId",
          "value": "SYN_INVALID_ID!"
        }
      ]
    },
    {
      "id": "bad-trust-domain-enum",
      "expectedLayer": "schema",
      "expectedCode": "SCHEMA_INVALID",
      "expectedPath": "$/trustDomain",
      "mutations": [
        {
          "operation": "replace",
          "path": "/trustDomain",
          "value": "real_public"
        }
      ]
    },
    {
      "id": "missing-crs",
      "expectedLayer": "schema",
      "expectedCode": "SCHEMA_INVALID",
      "expectedPath": "$",
      "mutations": [
        {
          "operation": "remove",
          "path": "/crs"
        }
      ]
    },
    {
      "id": "additional-root-property",
      "expectedLayer": "schema",
      "expectedCode": "SCHEMA_INVALID",
      "expectedPath": "$",
      "mutations": [
        {
          "operation": "add",
          "path": "/extraField",
          "value": "synthetic-extra"
        }
      ]
    },
    {
