      "mutations": [
        {
          "operation": "add",
          "path": "/geometryRef/coordinates",
          "value": [1, 2]
        }
      ]
    },
    {
      "id": "protected-key-geometry-in-geometryref",
      "expectedLayer": "schema",
      "expectedCode": "PROTECTED_KEY",
      "expectedPath": "$/field/geometry",
      "mutations": [
        {
          "operation": "add",
          "path": "/geometryRef/geometry",
          "value": {}
        }
      ]
    },
    {
