    {
      "id": "sensitivity-too-low-tribal-supplier",
      "expectedLayer": "semantic",
      "expectedCode": "SENSITIVITY_TOO_LOW",
      "expectedPath": "$/sensitivity",
      "mutations": [
        {
          "operation": "replace",
          "path": "/supplierClass",
          "value": "tribal_government"
