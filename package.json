{
  "name": "policy-sentinel",
  "version": "0.9.8",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Policy monitoring and source reference for Tribal policy staff",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-synthetic-artifact.mjs --out dist/data && npm run validate:artifact",
    "preview": "vite preview",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:build": "node scripts/finish-demo-build.mjs --build && node scripts/check-pages-files.mjs",
    "demo:worker:dev": "npx wrangler@4.151.3 dev --config worker/wrangler.toml",
    "demo:worker:deploy": "npx wrangler@4.151.3 deploy --config worker/wrangler.toml",
    "policy:replay": "node scripts/replay-policy-corpus.mjs",
    "policy:build:local": "node scripts/build-policy-local.mjs",
    "policy:serve:local": "node scripts/serve-policy-local.mjs",
    "storage:report": "node scripts/report-storage.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs --dir dist/data",
    "validate:foundation": "node scripts/validate-foundation.mjs",
    "validate:demo-index": "node scripts/validate-demo-index.mjs --dir docs/demo-data",
    "check:freshness": "node scripts/check-index-freshness.mjs",
    "source:wa-lws:canary": "node scripts/observe-washington-lws-canary.mjs",
    "scan:source": "node scripts/scan-source-boundary.mjs && node scripts/check-pages-files.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:engine": "node --test --test-concurrency=1 tests/pipeline/*.test.mjs",
    "test:tier1": "node --test --test-concurrency=1 tests/adapters/federal-register/tier1-contract.test.mjs tests/adapters/federal-register/tier1-refresh.test.mjs tests/adapters/federal-register/tier1-transport.test.mjs",
    "test:unit": "vitest run --maxWorkers=1 --pool=threads",
    "test": "npm run test:engine && npm run test:tier1 && npm run test:unit",
    "check": "npm run typecheck && npm run lint && npm run validate:foundation && npm run scan:source && npm run validate:demo-index && npm test && npm run build && npm run demo:build"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "1.0.19",
    "@pdf-lib/fontkit": "1.1.1",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "saxes": "6.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "24.19.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2"
}
