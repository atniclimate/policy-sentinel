{
  "description": "Local Policy Sentinel recovery context and narrow closed-gate guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hooks.mjs\"",
            "commandWindows": "cmd.exe /d /s /c \"for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @node \"%R\\scripts\\codex-hooks.mjs\"\"",
            "timeout": 30,
            "statusMessage": "Loading Policy Sentinel recovery state",
            "additionalContextLimit": 1400
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hooks.mjs\"",
            "commandWindows": "cmd.exe /d /s /c \"for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @node \"%R\\scripts\\codex-hooks.mjs\"\"",
            "timeout": 15,
            "statusMessage": "Checking Policy Sentinel gates"
          }
        ]
      }
    ]
  }
}
