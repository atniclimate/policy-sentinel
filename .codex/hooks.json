{
  "description": "Local Policy Sentinel recovery, gate, validation, and stop guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hooks.mjs\"",
            "commandWindows": "cmd.exe /d /s /c \"for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @node \"%R\\scripts\\codex-hooks.mjs\"\"",
            "timeout": 30,
            "statusMessage": "Loading Policy Sentinel recovery state",
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hooks.mjs\"",
            "commandWindows": "cmd.exe /d /s /c \"for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @node \"%R\\scripts\\codex-hooks.mjs\"\"",
            "timeout": 30,
            "statusMessage": "Checking durable state before compaction"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hooks.mjs\"",
            "commandWindows": "cmd.exe /d /s /c \"for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @node \"%R\\scripts\\codex-hooks.mjs\"\"",
            "timeout": 15,
            "statusMessage": "Checking Policy Sentinel gates"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hooks.mjs\"",
            "commandWindows": "cmd.exe /d /s /c \"for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @node \"%R\\scripts\\codex-hooks.mjs\"\"",
            "timeout": 120,
            "statusMessage": "Running focused post-edit checks",
            "additionalContextLimit": 2200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hooks.mjs\"",
            "commandWindows": "cmd.exe /d /s /c \"for /f \"delims=\" %R in ('git rev-parse --show-toplevel') do @node \"%R\\scripts\\codex-hooks.mjs\"\"",
            "timeout": 30,
            "statusMessage": "Checking the durable stopping state"
          }
        ]
      }
    ]
  }
}
