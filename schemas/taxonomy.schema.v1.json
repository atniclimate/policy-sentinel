{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-sentinel.invalid/schemas/taxonomy.schema.v1.json",
  "title": "Policy Sentinel taxonomy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taxonomyVersion",
    "title",
    "mappingPolicy",
    "categories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "taxonomyVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mappingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "manyToMany",
        "unmappedBehavior",
        "sourceMappings"
      ],
      "properties": {
        "method": {
          "const": "deterministic-official-subject-only"
        },
        "manyToMany": {
          "const": true
        },
        "unmappedBehavior": {
          "const": "unclassified"
        },
        "sourceMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceMapping"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "subcategories"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "subcategories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subcategory"
          }
        }
      }
    },
    "subcategory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "officialSubjectScheme",
        "officialSubjectValue",
        "targets",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "sourceId": {
          "$ref": "#/$defs/slug"
        },
        "officialSubjectScheme": {
          "type": "string",
          "minLength": 1
        },
        "officialSubjectValue": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "categoryId"
            ],
            "properties": {
              "categoryId": {
                "$ref": "#/$defs/slug"
              },
              "subcategoryId": {
                "$ref": "#/$defs/slug"
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceUrl",
            "retrievedAt",
            "validationState"
          ],
          "properties": {
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "retrievedAt": {
              "type": "string",
              "format": "date-time"
            },
            "validationState": {
              "enum": [
                "pending",
                "validated",
                "rejected"
              ]
            }
          }
        }
      }
    }
  }
}
