{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json",
  "title": "AnalyzedCorpus 2.0.0 — source-neutral local evidence corpus",
  "description": "Closed local-only structural contract. Semantic validation also verifies digests, exact evidence references and spans, reviewed source uses, source/observation dates, coverage, provenance and separately supplied last-known-good corpus proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "runId",
    "trustDomain",
    "generatedAt",
    "sourceProfiles",
    "captures",
    "works",
    "versions",
    "renditions",
    "segments",
    "events",
    "relationships",
    "analyses",
    "findings",
    "coverage",
    "contentDigest"
  ],
  "properties": {
    "$schema": {
      "const": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "analyzed_corpus"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
    },
    "trustDomain": {
      "enum": ["real_source_local", "synthetic_test_only"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceProfile"
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "captures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capture"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/version"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "renditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rendition"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "analyses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/analysis"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "date": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "precision"],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^\\d{4}$"
            },
            "precision": {
              "const": "year"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "precision"],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "precision": {
              "const": "month"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "precision"],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "precision": {
              "const": "day"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "precision"],
          "properties": {
            "value": {
              "type": "null"
            },
            "precision": {
              "const": "unknown"
            }
          }
        }
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "reviewedAt"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": ["agent", "human", "rule"]
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "mode",
        "captureId",
        "sourceLocator",
        "segmentIds",
        "ruleId"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "mode": {
          "enum": ["source_attested", "deterministic"]
        },
        "captureId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "sourceLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "segmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "ruleId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sourceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "interfaceId",
        "operator",
        "publisher",
        "authorityLabel",
        "hosts",
        "pathPrefixes",
        "review",
        "uses",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "interfaceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "authorityLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 10
        },
        "pathPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 100
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "reviewedAt", "expiresAt", "evidenceUrls"],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "reviewedAt": {
              "type": "string",
              "format": "date-time"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "evidenceUrls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1,
              "maxItems": 100
            }
          }
        },
        "uses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capture",
            "analysis",
            "localDisplay",
            "localExport",
            "excerpts",
            "publicRedistribution"
          ],
          "properties": {
            "capture": {
              "const": true
            },
            "analysis": {
              "const": true
            },
            "localDisplay": {
              "enum": ["full_text", "excerpt", "metadata_link"]
            },
            "localExport": {
              "enum": ["full_text", "excerpt", "metadata_link", "prohibited"]
            },
            "excerpts": {
              "type": "boolean"
            },
            "publicRedistribution": {
              "const": "prohibited"
            }
          }
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceProfileId",
        "sourceProfileDigest",
        "operationId",
        "requestedUrl",
        "finalUrl",
        "retrievedAt",
        "mediaType",
        "encodedBytes",
        "decodedBytes",
        "objectDigest",
        "objectPath",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "sourceProfileId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "sourceProfileDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "requestedUrl": {
          "type": "string",
          "format": "uri"
        },
        "finalUrl": {
          "type": "string",
          "format": "uri"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "mediaType": {
          "enum": [
            "text/plain",
            "text/html",
            "application/xhtml+xml",
            "application/xml",
            "text/xml",
            "application/pdf",
            "application/json"
          ]
        },
        "encodedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "decodedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "objectDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objectPath": {
          "type": "string",
          "pattern": "^objects/(?:[a-f0-9]{64}\\.bin|sha256/[a-f0-9]{2}/[a-f0-9]{2}/[a-f0-9]{64})$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceProfileId",
        "sourceIdentifier",
        "title",
        "instrumentClass",
        "governmentContext",
        "issuerRoles",
        "relevance",
        "taxonomy",
        "fieldProvenance",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "sourceProfileId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "sourceIdentifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "instrumentClass": {
          "enum": [
            "regulation",
            "proposed_rule",
            "final_rule",
            "statute",
            "bill",
            "executive_order",
            "judicial_opinion",
            "intergovernmental_agreement",
            "agency_policy",
            "notice"
          ]
        },
        "governmentContext": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuerRoles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "label"],
            "properties": {
              "role": {
                "enum": [
                  "issuer",
                  "speaker",
                  "party",
                  "regulator",
                  "legislative_sponsor"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "minItems": 1,
          "maxItems": 100
        },
        "relevance": {
          "const": "general_jurisdiction"
        },
        "taxonomy": {
          "const": "Unclassified"
        },
        "fieldProvenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 6,
          "maxItems": 10000
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workId",
        "sourceVersionIdentifier",
        "sourceStatusLabel",
        "dates",
        "observedAt",
        "renditionIds",
        "fieldProvenance",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "workId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "sourceVersionIdentifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sourceStatusLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publication", "sourceVersion"],
          "properties": {
            "publication": {
              "$ref": "#/$defs/date"
            },
            "sourceVersion": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "renditionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
          },
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "fieldProvenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 2,
          "maxItems": 10000
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "rendition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "versionId",
        "captureId",
        "parser",
        "mediaType",
        "outputDigest",
        "byteLength",
        "text",
        "authorityLabel",
        "warnings",
        "omittedSourceLocators",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "captureId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "configDigest"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "configDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "mediaType": {
          "const": "text/plain"
        },
        "outputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 67108864
        },
        "authorityLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 100
        },
        "omittedSourceLocators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/[^\\r\\n]+$"
          },
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value",
        "headingPath",
        "printedPageLabel",
        "physicalPageIndex"
      ],
      "properties": {
        "type": {
          "enum": ["structural_path", "paragraph", "line", "page"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "headingPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 100
        },
        "printedPageLabel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "physicalPageIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "renditionId",
        "startByte",
        "endByte",
        "textDigest",
        "contextDigest",
        "locator",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "renditionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "startByte": {
          "type": "integer",
          "minimum": 0
        },
        "endByte": {
          "type": "integer",
          "minimum": 1
        },
        "textDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workId",
        "versionId",
        "type",
        "date",
        "sourceStatedAt",
        "sourceLabel",
        "segmentIds",
        "fieldProvenance",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "workId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "type": {
          "enum": [
            "published",
            "enacted",
            "effective",
            "amended",
            "repealed",
            "corrected",
            "withdrawn"
          ]
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "sourceStatedAt": {
          "$ref": "#/$defs/date"
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "segmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
          },
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "fieldProvenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fromVersionId",
        "type",
        "target",
        "sourceLabel",
        "sourceStatedAt",
        "segmentIds",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "fromVersionId": {
          "type": "string",
