                "maxItems": 100000,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
