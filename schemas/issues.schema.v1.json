{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-sentinel.invalid/schemas/issues.schema.v1.json",
  "title": "Policy Sentinel reviewed issue table",
  "$comment": "D-163 to D-165: curated config, bundled into the demo page, never fetched. An issue names a subject, never a position or an effect (safeguard 2); a measure is a bill or rule that carries issues; a provision is one section of one version of a measure filed under one issue, by citing an identifier the issue rests on or by the owner's review alone. The owner reviews every row; no model output is published unreviewed (design rule 8). Mirrors src/demo/issues.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "artifactType", "entries"],
  "properties": {
    "$schema": {
      "const": "../schemas/issues.schema.v1.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "artifactType": {
      "const": "issues"
    },
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/tableEntry"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^<>]*$"
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[^<>]*$",
      "$comment": "verbatim official wording or heading"
    },
    "entryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "officialUrl": {
      "type": "string",
      "maxLength": 400,
      "pattern": "^https://(www\\.govinfo\\.gov|www\\.congress\\.gov|uscode\\.house\\.gov|www\\.ecfr\\.gov|www\\.federalregister\\.gov|www\\.regulations\\.gov|www\\.fs\\.usda\\.gov|www\\.armed-services\\.senate\\.gov)/"
    },
    "contextUrl": {
      "type": "string",
      "maxLength": 400,
      "pattern": "^https://(www\\.govinfo\\.gov|www\\.congress\\.gov|uscode\\.house\\.gov|www\\.ecfr\\.gov|www\\.federalregister\\.gov|www\\.regulations\\.gov|www\\.fs\\.usda\\.gov|www\\.armed-services\\.senate\\.gov|protect106\\.org)/",
      "$comment": "officialUrl plus protect106.org, context only"
    },
    "identifierKind": {
      "enum": [
        "usc",
        "cfr",
        "public_law",
        "executive_order",
        "fr_document",
        "docket",
        "rin",
        "bill"
      ]
    },
    "issueIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "url", "stated", "readOn"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifierKind" },
        "id": { "$ref": "#/$defs/shortText" },
        "label": { "$ref": "#/$defs/shortText" },
        "url": { "$ref": "#/$defs/officialUrl" },
        "stated": { "$ref": "#/$defs/longText" },
        "readOn": { "$ref": "#/$defs/date" }
      }
    },
    "issueName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "basis", "reviewedOn"],
      "properties": {
        "name": { "$ref": "#/$defs/shortText" },
        "basis": { "enum": ["official", "people_use"] },
        "statedAt": { "$ref": "#/$defs/officialUrl" },
        "wording": { "$ref": "#/$defs/longText" },
        "reviewedOn": { "$ref": "#/$defs/date" }
      },
      "allOf": [
        {
          "if": {
            "required": ["basis"],
            "properties": { "basis": { "const": "official" } }
          },
          "then": { "required": ["statedAt", "wording"] }
        },
        {
          "if": {
            "required": ["basis"],
            "properties": { "basis": { "const": "people_use" } }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["statedAt"] },
                { "required": ["wording"] }
              ]
            }
          }
        }
      ]
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "bill",
        "version",
        "section",
        "heading",
        "url",
        "readOn",
        "basis",
        "reviewedOn"
      ],
      "properties": {
        "issue": { "$ref": "#/$defs/shortText" },
        "bill": { "$ref": "#/$defs/shortText" },
        "version": { "$ref": "#/$defs/shortText" },
        "section": { "$ref": "#/$defs/shortText" },
        "heading": { "$ref": "#/$defs/longText" },
        "url": { "$ref": "#/$defs/officialUrl" },
        "readOn": { "$ref": "#/$defs/date" },
        "basis": { "enum": ["cites", "listed"] },
        "cites": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shortText" }
        },
        "reviewedOn": { "$ref": "#/$defs/date" }
      },
      "allOf": [
        {
          "if": {
            "required": ["basis"],
            "properties": { "basis": { "const": "cites" } }
          },
          "then": { "required": ["cites"] }
        },
        {
          "if": {
            "required": ["basis"],
            "properties": { "basis": { "const": "listed" } }
          },
          "then": { "not": { "required": ["cites"] } }
        }
      ]
    },
    "planSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "source", "query", "auto"],
      "properties": {
        "group": { "enum": ["policy", "legislation", "bill", "case"] },
        "source": {
          "enum": [
            "federal-register",
            "govinfo",
            "govinfo-courts",
            "congress",
            "regulations",
            "grants",
            "washington"
          ]
        },
        "query": { "$ref": "#/$defs/shortText" },
        "label": { "$ref": "#/$defs/shortText" },
        "terms": { "$ref": "#/$defs/shortText" },
        "collection": { "$ref": "#/$defs/shortText" },
        "auto": { "const": true },
        "match": { "enum": ["docket", "rin", "cfr"] },
        "lookup": { "enum": ["court_docket", "us_reports"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "label"],
      "properties": {
        "url": { "$ref": "#/$defs/contextUrl" },
        "label": { "$ref": "#/$defs/shortText" }
      }
    },
    "issueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "names",
        "searches",
        "reviewedOn",
        "reviewerRole",
        "restsOn"
      ],
      "properties": {
        "kind": { "const": "issue" },
        "id": { "$ref": "#/$defs/entryId" },
        "label": { "$ref": "#/$defs/shortText" },
        "names": { "type": "array", "items": { "$ref": "#/$defs/issueName" } },
        "searches": {
          "type": "array",
          "items": { "$ref": "#/$defs/planSearch" }
        },
        "context": { "$ref": "#/$defs/context" },
        "reviewedOn": { "$ref": "#/$defs/date" },
        "reviewerRole": { "const": "owner" },
        "restsOn": {
          "type": "array",
          "items": { "$ref": "#/$defs/issueIdentifier" }
        }
      }
    },
    "measureEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "names",
        "searches",
        "reviewedOn",
        "reviewerRole",
        "identifiers",
        "provisions"
      ],
      "properties": {
        "kind": { "const": "measure" },
        "id": { "$ref": "#/$defs/entryId" },
        "label": { "$ref": "#/$defs/shortText" },
        "names": { "type": "array", "items": { "$ref": "#/$defs/issueName" } },
        "searches": {
          "type": "array",
          "items": { "$ref": "#/$defs/planSearch" }
        },
        "context": { "$ref": "#/$defs/context" },
        "reviewedOn": { "$ref": "#/$defs/date" },
        "reviewerRole": { "const": "owner" },
        "identifiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/issueIdentifier" }
        },
        "provisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provision" }
        }
      }
    },
    "tableEntry": {
      "oneOf": [
        { "$ref": "#/$defs/issueEntry" },
        { "$ref": "#/$defs/measureEntry" }
      ]
    }
  }
}
