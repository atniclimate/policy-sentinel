{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-sentinel.invalid/schemas/development-authority.schema.v1.json",
  "title": "GD-31 successor preparation contracts",
  "description": "Closed local preparation contracts only. Validation does not authorize acquisition, activation, exchange, output or publication.",
  "oneOf": [
    {
      "$ref": "#/$defs/sourcePacket"
    },
    {
      "$ref": "#/$defs/exchange"
    },
    {
      "$ref": "#/$defs/restrictionSet"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
    },
    "fields": {
      "type": "array",
      "items": {
        "enum": [
          "sourceId",
          "sourceUrl",
          "title",
          "documentType",
          "version",
          "status",
          "dates",
          "locator",
          "quotation",
          "sourceHealth",
          "coverage",
          "analystNote",
          "finding"
        ]
      },
      "minItems": 0,
      "maxItems": 13,
      "uniqueItems": true
    },
    "dateWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "through"],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "through": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "restriction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "agreementRef",
        "recipients",
        "purposes",
        "allowedFields",
        "onwardSharing",
        "retentionDays",
        "validFrom",
        "expiresAt",
        "withdrawn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
        },
        "classification": {
          "enum": ["public", "private", "shared"]
        },
        "agreementRef": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
            }
          ]
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "purposes": {
          "type": "array",
          "items": {
            "enum": ["policy_search", "citation_export", "case_export"]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "allowedFields": {
          "$ref": "#/$defs/fields"
        },
        "onwardSharing": {
          "type": "boolean"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "withdrawn": {
          "type": "boolean"
        }
      }
    },
    "restrictionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schemaVersion",
        "dispatchAllowed",
        "synthetic",
        "kind",
        "source",
        "authored"
      ],
      "properties": {
        "$schema": {
          "const": "https://policy-sentinel.invalid/schemas/development-authority.schema.v1.json"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "dispatchAllowed": {
          "const": false
        },
        "synthetic": {
          "type": "boolean"
        },
        "kind": {
          "const": "restriction_set"
        },
        "source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/restriction"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "authored": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/restriction"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "authorityClass",
        "access",
        "jurisdictionIds",
        "family",
        "officialUrls",
        "interfaces",
        "dateWindow",
        "bounds",
        "review",
        "reuseReview",
        "outputFields",
        "custodyNamespace"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
        },
        "authorityClass": {
          "enum": [
            "federal",
            "state",
            "county",
            "municipal",
            "tribal_government",
            "intertribal_organization"
          ]
        },
        "access": {
          "enum": ["public", "restricted"]
        },
        "jurisdictionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-zA-Z0-9:._-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "officialUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "interfaces": {
          "type": "array",
          "items": {
            "enum": ["api", "html", "xml", "pdf", "manual_import"]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "dateWindow": {
          "$ref": "#/$defs/dateWindow"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "retries",
            "maxBytes",
            "maxBytesPerRequest",
            "requestsPerMinute",
            "timeoutMs",
            "concurrency"
          ],
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10737418240
            },
            "maxBytesPerRequest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10737418240
            },
            "requestsPerMinute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 120000
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "evidenceRefs", "expiresAt", "blockReasons"],
          "properties": {
            "state": {
              "enum": ["pending", "reviewed_preparation", "blocked"]
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 0,
              "maxItems": 128,
              "uniqueItems": true
            },
            "expiresAt": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ]
            },
            "blockReasons": {
              "type": "array",
              "items": {
                "enum": [
                  "authority",
                  "access",
                  "reuse",
                  "interface",
                  "credentials",
                  "coverage",
                  "capacity",
                  "expired_review",
                  "contract_migration"
                ]
              },
              "minItems": 0,
              "maxItems": 9,
              "uniqueItems": true
            }
          }
        },
        "reuseReview": {
          "enum": ["pending", "metadata_only", "reviewed_fields"]
        },
        "outputFields": {
          "type": "array",
          "items": {
            "enum": [
              "sourceId",
              "sourceUrl",
              "title",
              "documentType",
              "version",
              "status",
              "dates",
              "locator",
              "quotation",
              "sourceHealth",
              "coverage"
            ]
          },
          "minItems": 0,
          "maxItems": 11,
          "uniqueItems": true
        },
        "custodyNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
        }
      }
    },
    "sourcePacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schemaVersion",
        "dispatchAllowed",
        "synthetic",
        "kind",
        "id",
        "decisionRefs",
        "storage",
        "sources"
      ],
      "properties": {
        "$schema": {
          "const": "https://policy-sentinel.invalid/schemas/development-authority.schema.v1.json"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "dispatchAllowed": {
          "const": false
        },
        "synthetic": {
          "type": "boolean"
        },
        "kind": {
          "const": "source_preparation"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
        },
        "decisionRefs": {
          "type": "array",
          "prefixItems": [
            {
              "const": "D-086"
            },
            {
              "const": "D-087"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "managedLimitBytes",
            "maxRunBytes",
            "minFreeBytes",
            "managedBytes",
            "peakAdditionalBytes",
            "freeBytes",
            "allManagedRootsInventoried",
            "measurementRefs"
          ],
          "properties": {
            "managedLimitBytes": {
              "const": 50000000000
            },
            "maxRunBytes": {
              "const": 10737418240
            },
            "minFreeBytes": {
              "const": 21474836480
            },
            "managedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000000000
            },
            "peakAdditionalBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10737418240
            },
            "freeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "allManagedRootsInventoried": {
              "type": "boolean"
            },
            "measurementRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 0,
              "maxItems": 128,
              "uniqueItems": true
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        }
      }
    },
    "exchange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "schemaVersion",
            "dispatchAllowed",
            "synthetic",
            "kind",
            "profile",
            "recipientId",
            "purpose",
            "storage",
            "corpus",
            "sensitivity",
            "criteria"
          ],
          "properties": {
            "$schema": {
              "const": "https://policy-sentinel.invalid/schemas/development-authority.schema.v1.json"
            },
            "schemaVersion": {
              "const": "1.0.0"
            },
            "dispatchAllowed": {
              "const": false
            },
            "synthetic": {
              "type": "boolean"
            },
            "kind": {
              "const": "exchange_preparation"
            },
            "profile": {
              "const": "policy.search-context/1"
            },
            "recipientId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
            },
            "purpose": {
              "const": "policy_search"
            },
            "storage": {
              "const": "memory_only"
            },
            "corpus": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id", "digest"],
              "properties": {
                "kind": {
                  "enum": ["public_synthetic", "reviewed_local"]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "sensitivity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tier", "derivedFromPrivate"],
              "properties": {
                "tier": {
                  "enum": ["T0", "T1", "T2", "T3"]
                },
                "derivedFromPrivate": {
                  "type": "boolean"
                }
              }
            },
            "criteria": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "jurisdictionIds",
                "topicIds",
                "sourceIds",
                "dateWindow",
                "query"
              ],
              "properties": {
                "jurisdictionIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-zA-Z0-9:._-]{0,127}$"
                  },
                  "minItems": 0,
                  "maxItems": 128,
                  "uniqueItems": true
                },
                "topicIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
                  },
                  "minItems": 0,
                  "maxItems": 128,
                  "uniqueItems": true
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
                  },
                  "minItems": 0,
                  "maxItems": 128,
                  "uniqueItems": true
                },
                "dateWindow": {
                  "$ref": "#/$defs/dateWindow"
                },
                "query": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "schemaVersion",
            "dispatchAllowed",
            "synthetic",
            "kind",
            "profile",
            "recipientId",
            "purpose",
            "storage",
            "corpus",
            "sensitivity",
            "criteria"
          ],
          "properties": {
            "$schema": {
              "const": "https://policy-sentinel.invalid/schemas/development-authority.schema.v1.json"
            },
            "schemaVersion": {
              "const": "1.0.0"
            },
            "dispatchAllowed": {
              "const": false
            },
            "synthetic": {
              "type": "boolean"
            },
            "kind": {
              "const": "exchange_preparation"
            },
            "profile": {
              "const": "policy.search-context.atni/1"
            },
            "recipientId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
            },
            "purpose": {
              "const": "policy_search"
            },
            "storage": {
              "const": "memory_only"
            },
            "corpus": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id", "digest"],
              "properties": {
                "kind": {
                  "enum": ["public_synthetic", "reviewed_local"]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "sensitivity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tier", "derivedFromPrivate"],
              "properties": {
                "tier": {
                  "enum": ["T0", "T1", "T2", "T3"]
                },
                "derivedFromPrivate": {
                  "type": "boolean"
                }
              }
            },
            "criteria": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "jurisdictionIds",
                "topicIds",
                "sourceIds",
                "dateWindow",
                "query"
              ],
              "properties": {
                "jurisdictionIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-zA-Z0-9:._-]{0,127}$"
                  },
                  "minItems": 0,
                  "maxItems": 128,
                  "uniqueItems": true
                },
                "topicIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
                  },
                  "minItems": 0,
                  "maxItems": 128,
                  "uniqueItems": true
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
                  },
                  "minItems": 0,
                  "maxItems": 128,
                  "uniqueItems": true
                },
                "dateWindow": {
                  "$ref": "#/$defs/dateWindow"
                },
                "query": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            },
            "selectedNation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "provenance", "deliberate"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^nation:[a-z][a-z0-9-]{0,100}$"
                },
                "provenance": {
                  "const": "user_declared"
                },
                "deliberate": {
                  "const": true
                }
              }
            }
          }
        }
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "recipientId",
        "purpose",
        "scope",
        "validFrom",
        "expiresAt",
        "revoked",
        "registryDigest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
        },
        "profile": {
          "enum": ["policy.search-context/1", "policy.search-context.atni/1"]
        },
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
        },
        "purpose": {
          "const": "policy_search"
        },
        "scope": {
          "const": "local_synthetic_assessment"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "revoked": {
          "type": "boolean"
        },
        "registryDigest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "synthetic", "nationIds"],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "synthetic": {
          "type": "boolean"
        },
        "nationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^nation:[a-z][a-z0-9-]{0,100}$"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipientId",
        "purpose",
        "fields",
        "onwardSharing",
        "retentionDays"
      ],
      "properties": {
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9:._-]{0,127}$"
        },
        "purpose": {
          "enum": ["policy_search", "citation_export", "case_export"]
        },
        "fields": {
          "$ref": "#/$defs/fields"
        },
        "onwardSharing": {
          "type": "boolean"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        }
      }
    }
  }
}
