{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-sentinel.invalid/schemas/source.schema.v1.json",
  "title": "Policy Sentinel source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "registryVersion",
    "generatedDataPolicy",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "registryVersion": {
      "const": "1.3.0"
    },
    "generatedDataPolicy": {
      "const": "artifact-only"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "nullableDate": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "module", "identityRule"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "module": {
          "type": "string",
          "pattern": "^(?:fixtures|src/adapters)/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+$"
        },
        "identityRule": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "provider",
        "synthetic",
        "enabled",
        "adapter",
        "jurisdiction",
        "access",
        "coverage",
        "publication",
        "officialSubjectMappings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "adapter": {
          "oneOf": [
            {
              "$ref": "#/$defs/adapter"
            },
            {
              "type": "null"
            }
          ]
        },
        "jurisdiction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "name", "stateCode"],
          "properties": {
            "level": {
              "enum": ["federal", "state", "county", "tribal", "other"]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "stateCode": {
              "oneOf": [
                {
                  "enum": ["WA", "OR", "ID"]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "officialDocumentationUrl",
            "allowedHosts",
            "authentication",
            "rateLimit",
            "browserRuntimeAllowed"
          ],
          "properties": {
            "method": {
              "enum": ["fixture", "api", "feed", "official_export"]
            },
            "officialDocumentationUrl": {
              "$ref": "#/$defs/httpsUrl"
            },
            "accessedOn": {
              "type": "string",
              "format": "date"
            },
            "allowedHosts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.-]+$"
              }
            },
            "authentication": {
              "enum": ["none", "build_secret"]
            },
            "rateLimit": {
              "type": "string",
              "minLength": 1
            },
            "browserRuntimeAllowed": {
              "const": false
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "through", "cadence", "limitations"],
          "properties": {
            "from": {
              "$ref": "#/$defs/nullableDate"
            },
            "through": {
              "$ref": "#/$defs/nullableDate"
            },
            "cadence": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attribution",
            "termsUrl",
            "reproduction",
            "failureMode",
            "requiredProvenancePointers"
          ],
          "properties": {
            "attribution": {
              "type": "string",
              "minLength": 1
            },
            "termsUrl": {
              "$ref": "#/$defs/httpsUrl"
            },
            "reproduction": {
              "enum": [
                "metadata_and_links",
                "reviewed_excerpt",
                "reviewed_full_text"
              ]
            },
            "failureMode": {
              "const": "last_known_good"
            },
            "requiredProvenancePointers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"
              }
            }
          }
        },
        "officialSubjectMappings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "adapter": {
                "$ref": "#/$defs/adapter"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": ["synthetic"]
          },
          "then": {
            "properties": {
              "access": {
                "type": "object",
                "properties": {
                  "method": {
                    "const": "fixture"
                  }
                }
              },
              "adapter": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/adapter"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "module": {
                            "type": "string",
                            "pattern": "^fixtures/"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "access": {
                "type": "object",
                "properties": {
                  "method": {
                    "enum": ["api", "feed", "official_export"]
                  }
                }
              },
              "adapter": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/adapter"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "module": {
                            "type": "string",
                            "pattern": "^src/adapters/"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": ["synthetic"]
          },
          "then": {
            "properties": {
              "access": {
                "type": "object",
                "required": ["accessedOn"],
                "properties": {
                  "accessedOn": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
