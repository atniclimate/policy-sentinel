{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.1.json",
  "title": "AnalyzedCorpus 2.1.0 — evidence-backed jurisdiction associations",
  "description": "Additive closed successor. Government context remains source text. Runtime binds every association to the same work/version, exact source statement, URL, locator, and attributed review; no association is inferred from discovery geography or organizational membership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "runId",
    "trustDomain",
    "generatedAt",
    "sourceProfiles",
    "captures",
    "works",
    "versions",
    "renditions",
    "segments",
    "events",
    "relationships",
    "analyses",
    "findings",
    "coverage",
    "contentDigest"
  ],
  "properties": {
    "$schema": {
      "const": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.1.json"
    },
    "schemaVersion": {
      "const": "2.1.0"
    },
    "kind": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/kind"
    },
    "id": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/id"
    },
    "runId": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/runId"
    },
    "trustDomain": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/trustDomain"
    },
    "generatedAt": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/generatedAt"
    },
    "sourceProfiles": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/sourceProfiles"
    },
    "captures": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/captures"
    },
    "works": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "versions": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/versions"
    },
    "renditions": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/renditions"
    },
    "segments": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/segments"
    },
    "events": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/events"
    },
    "relationships": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/relationships"
    },
    "analyses": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/analyses"
    },
    "findings": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/findings"
    },
    "coverage": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/coverage"
    },
    "contentDigest": {
      "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/properties/contentDigest"
    }
  },
  "$defs": {
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceProfileId",
        "sourceIdentifier",
        "title",
        "instrumentClass",
        "governmentContext",
        "issuerRoles",
        "relevance",
        "taxonomy",
        "fieldProvenance",
        "contentDigest",
        "jurisdictionRefs"
      ],
      "properties": {
        "id": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/id"
        },
        "sourceProfileId": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/sourceProfileId"
        },
        "sourceIdentifier": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/sourceIdentifier"
        },
        "title": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/title"
        },
        "instrumentClass": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/instrumentClass"
        },
        "governmentContext": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/governmentContext"
        },
        "issuerRoles": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/issuerRoles"
        },
        "relevance": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/relevance"
        },
        "taxonomy": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/taxonomy"
        },
        "fieldProvenance": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/fieldProvenance"
        },
        "contentDigest": {
          "$ref": "https://policy-sentinel.invalid/schemas/analyzed-corpus.schema.v2.json#/$defs/work/properties/contentDigest"
        },
        "jurisdictionRefs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/association"
          }
        }
      }
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdictionRef",
        "basis",
        "evidence",
        "reviewState",
        "versionId",
        "segmentIds",
        "reviewer"
      ],
      "properties": {
        "jurisdictionRef": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^(?:us|us-state:[A-Z]{2}|us-county:[0-9]{5}|nation:[a-z0-9]+(?:-[a-z0-9]+)*|body:[a-z0-9]+(?:-[a-z0-9]+)*)$"
        },
        "basis": {
          "enum": ["issuing_authority", "source_stated_scope"]
        },
        "reviewState": {
          "enum": ["unreviewed", "reviewed", "rejected"]
        },
        "versionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
        },
        "segmentIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9:._-]{0,191}$"
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "locator", "exactSubject"],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "format": "uri",
              "pattern": "^https://"
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "exactSubject": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recordRef", "ref", "text"],
              "properties": {
                "recordRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "ref": {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^(?:us|us-state:[A-Z]{2}|us-county:[0-9]{5}|nation:[a-z0-9]+(?:-[a-z0-9]+)*|body:[a-z0-9]+(?:-[a-z0-9]+)*)$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              }
            }
          }
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "reviewedAt"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "kind": {
                  "enum": ["agent", "human", "rule"]
                },
                "reviewedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        }
      }
    }
  }
}
