{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-sentinel.invalid/schemas/artifact.schema.v1.json",
  "title": "Policy Sentinel static artifact document",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/coverage"
    },
    {
      "$ref": "#/$defs/sourceHealthCollection"
    },
    {
      "$ref": "#/$defs/nationCollection"
    },
    {
      "$ref": "#/$defs/recordIndex"
    },
    {
      "$ref": "#/$defs/recordDetail"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "nullableDate": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableDateTime": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "name", "stateCode"],
      "properties": {
        "level": {
          "enum": ["federal", "state", "county", "tribal", "other"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stateCode": {
          "oneOf": [
            {
              "enum": ["WA", "OR", "ID"]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "schemaVersion",
        "artifactVersion",
        "buildId",
        "generatedAt",
        "dataAsOf",
        "synthetic",
        "recordSchemaVersion",
        "taxonomyVersion",
        "sourceRegistryVersion",
        "recordCount",
        "nationCount",
        "assets"
      ],
      "properties": {
        "artifactType": {
          "const": "manifest"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "artifactVersion": {
          "enum": ["1.0.0", "1.1.0"]
        },
        "buildId": {
          "type": "string",
          "pattern": "^synthetic-[a-f0-9]{20}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "dataAsOf": {
          "type": "string",
          "format": "date-time"
        },
        "synthetic": {
          "type": "boolean"
        },
        "recordSchemaVersion": {
          "enum": ["1.0.0", "1.1.0"]
        },
        "taxonomyVersion": {
          "const": "1.0.0"
        },
        "sourceRegistryVersion": {
          "enum": ["1.0.0", "1.1.0", "1.2.0"]
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "nationCount": {
          "const": 575
        },
        "assets": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "sizeBytes",
              "mediaType",
              "sourceIds"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:coverage|source-health|nations|taxonomy)\\.json$|^index/records\\.json$|^details/[A-Za-z0-9_-]+\\.json$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              },
              "mediaType": {
                "const": "application/json"
              },
              "sourceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/slug"
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "schemaVersion",
        "generatedAt",
        "notices",
        "entries"
      ],
      "properties": {
        "artifactType": {
          "const": "coverage"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "jurisdiction",
              "from",
              "through",
              "cadence",
              "recordTypes",
              "status",
              "limitation"
            ],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/slug"
              },
              "sourceName": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "jurisdiction": {
                "$ref": "#/$defs/jurisdiction"
              },
              "from": {
                "$ref": "#/$defs/nullableDate"
              },
              "through": {
                "$ref": "#/$defs/nullableDate"
              },
              "documentedFrom": {
                "$ref": "#/$defs/nullableDate"
              },
              "documentedThrough": {
                "$ref": "#/$defs/nullableDate"
              },
              "recordFrom": {
                "$ref": "#/$defs/nullableDate"
              },
              "recordThrough": {
                "$ref": "#/$defs/nullableDate"
              },
              "recordCount": {
                "type": "integer",
                "minimum": 0
              },
              "cadence": {
                "type": "string",
                "minLength": 1
              },
              "recordTypes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": ["synthetic", "available", "limited", "unavailable"]
              },
              "limitation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sourceHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceName",
        "status",
        "checkedAt",
        "dataAsOf",
        "lastSuccessfulRetrievalAt",
        "usingLastKnownGood",
        "stale",
        "recordCount",
        "failureStage",
        "message"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/slug"
        },
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["healthy", "degraded", "failed", "unavailable", "unknown"]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "dataAsOf": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "lastSuccessfulRetrievalAt": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "usingLastKnownGood": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "failureStage": {
          "oneOf": [
            {
              "enum": [
                "contract",
                "discovery",
                "fetch",
                "normalize",
                "validation",
                "packaging"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": ["string", "null"]
        }
      }
    },
    "sourceHealthCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "schemaVersion", "generatedAt", "sources"],
      "properties": {
        "artifactType": {
          "const": "source-health"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceHealth"
          }
        }
      }
    },
    "nation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "officialName",
        "authorizedAliases",
        "recognitionBaselineVersion",
        "stateCoverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^nation:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "officialName": {
          "type": "string",
          "minLength": 1
        },
        "authorizedAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recognitionBaselineVersion": {
          "type": "string",
          "minLength": 1
        },
        "stateCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["states", "federalOnly", "basis"],
          "properties": {
            "states": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["WA", "OR", "ID"]
              }
            },
            "federalOnly": {
              "type": "boolean"
            },
            "basis": {
              "enum": [
                "synthetic_fixture",
                "reviewed_official_crosswalk",
                "unresolved_no_reviewed_crosswalk"
              ]
            }
          }
        },
        "aliasProvenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alias",
              "basis",
              "evidenceText",
              "evidenceUrl",
              "retrievedAt",
              "validationState"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "const": "official_cross_reference"
              },
              "evidenceText": {
                "type": "string",
                "minLength": 1
              },
              "evidenceUrl": {
                "$ref": "#/$defs/httpsUrl"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              },
              "validationState": {
                "const": "validated"
              }
            }
          }
        },
        "sourceIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "officialListEntry": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "enum": ["contiguous_48", "alaska"]
        },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exactText",
              "paragraphId",
              "page",
              "section",
              "sourceUrl",
              "officialTextUrl",
              "officialPdfUrl"
            ],
            "properties": {
              "exactText": {
                "type": "string",
                "minLength": 1
              },
              "paragraphId": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": ["string", "null"]
              },
              "section": {
                "enum": ["contiguous_48", "alaska"]
              },
              "sourceUrl": {
                "$ref": "#/$defs/httpsUrl"
              },
              "officialTextUrl": {
                "$ref": "#/$defs/httpsUrl"
              },
              "officialPdfUrl": {
                "$ref": "#/$defs/httpsUrl"
              }
            }
          }
        },
        "fieldProvenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "sourceUrl",
              "sourceDate",
              "retrievedAt",
              "transformation",
              "transformRuleId",
              "validationState"
            ],
            "properties": {
              "field": {
                "enum": ["/officialName", "/authorizedAliases"]
              },
              "sourceUrl": {
                "$ref": "#/$defs/httpsUrl"
              },
              "sourceDate": {
                "type": "string",
                "format": "date"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              },
              "transformation": {
                "enum": ["copied", "reconciled_official_cross_reference"]
              },
              "transformRuleId": {
                "type": ["string", "null"]
              },
              "validationState": {
                "const": "validated"
              }
            }
          }
        }
      }
    },
    "nationCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "schemaVersion",
        "generatedAt",
        "baseline",
        "nations"
      ],
      "properties": {
        "artifactType": {
          "const": "nation-collection"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "registryVersion": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "version",
            "authorityName",
            "authorityUrl",
            "synthetic"
          ],
          "properties": {
            "count": {
              "const": 575
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "authorityName": {
              "type": "string",
              "minLength": 1
            },
            "authorityUrl": {
              "$ref": "#/$defs/httpsUrl"
            },
            "synthetic": {
              "type": "boolean"
            },
            "documentNumber": {
              "type": "string",
              "minLength": 1
            },
            "publicationDate": {
              "type": "string",
              "format": "date"
            },
            "officialTextUrl": {
              "$ref": "#/$defs/httpsUrl"
            },
            "officialPdfUrl": {
              "$ref": "#/$defs/httpsUrl"
            },
            "structuredTranscriptionUrl": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        },
        "nations": {
          "type": "array",
          "minItems": 575,
          "maxItems": 575,
          "items": {
            "$ref": "#/$defs/nation"
          }
        },
        "identityRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "description"],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "publicationReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "blocking", "reasonCode", "note", "reviewedAt"],
          "properties": {
            "state": {
              "enum": ["required_before_publication", "completed"]
            },
            "blocking": {
              "type": "boolean"
            },
            "reasonCode": {
              "$ref": "#/$defs/slug"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "reviewedAt": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "rawEntryCount",
            "reconciledNationCount",
            "uniqueIdCount",
            "uniqueOfficialNameCount",
            "transcriptCompared",
            "reconciliationRuleIds"
          ],
          "properties": {
            "state": {
              "const": "validated"
            },
            "rawEntryCount": {
              "type": "integer",
              "minimum": 575
            },
            "reconciledNationCount": {
              "const": 575
            },
            "uniqueIdCount": {
              "const": 575
            },
            "uniqueOfficialNameCount": {
              "const": 575
            },
            "transcriptCompared": {
              "const": true
            },
            "reconciliationRuleIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/slug"
              }
            }
          }
        },
        "sourceHealth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checkedAt",
            "dataAsOf",
            "lastSuccessfulRetrievalAt",
            "usingLastKnownGood",
            "message"
          ],
          "properties": {
            "status": {
              "const": "healthy"
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time"
            },
            "dataAsOf": {
              "type": "string",
              "format": "date"
            },
            "lastSuccessfulRetrievalAt": {
              "type": "string",
              "format": "date-time"
            },
            "usingLastKnownGood": {
              "const": false
            },
            "message": {
              "type": "null"
            }
          }
        }
      }
    },
    "indexJurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "name", "stateCode", "generalJurisdictionOnly"],
      "properties": {
        "level": {
          "enum": ["federal", "state", "county", "tribal", "other"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stateCode": {
          "oneOf": [
            {
              "enum": ["WA", "OR", "ID"]
            },
            {
              "type": "null"
            }
          ]
        },
        "generalJurisdictionOnly": {
          "type": "boolean"
        }
      }
    },
    "recordIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "detailPath",
        "officialTitle",
        "documentType",
        "jurisdiction",
        "status",
        "source",
        "dates",
        "taxonomyMemberships",
        "isUnclassified",
        "nationIds",
        "relevance",
        "landmark",
        "change"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^psr:"
        },
        "detailPath": {
          "type": "string",
          "pattern": "^details/[A-Za-z0-9_-]+\\.json$"
        },
        "sourceDocumentIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "officialTitle": {
          "type": "string",
          "minLength": 1
        },
        "documentType": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "$ref": "#/$defs/indexJurisdiction"
        },
        "issuingBodies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "object"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "provider"],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dates": {
          "type": "object"
        },
        "urls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["officialSource"],
          "properties": {
            "officialSource": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        },
        "taxonomyMemberships": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["categoryId", "subcategoryId"],
            "properties": {
              "categoryId": {
                "$ref": "#/$defs/slug"
              },
              "subcategoryId": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/slug"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "isUnclassified": {
          "type": "boolean"
        },
        "nationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^nation:"
          }
        },
        "relevance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "landmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["isLandmark"],
          "properties": {
            "isLandmark": {
              "type": "boolean"
            }
          }
        },
        "change": {
          "type": "object"
        }
      }
    },
    "recordIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "schemaVersion", "generatedAt", "records"],
      "properties": {
        "artifactType": {
          "const": "record-index"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recordIndexEntry"
          }
        }
      }
    },
    "recordDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "schemaVersion", "generatedAt", "record"],
      "properties": {
        "artifactType": {
          "const": "record-detail"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "record": {
          "type": "object"
        }
      }
    }
  }
}
