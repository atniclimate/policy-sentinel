{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-sentinel.invalid/schemas/artifact.schema.v1.json",
  "title": "Policy Sentinel static artifact document",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/coverage"
    },
    {
      "$ref": "#/$defs/sourceHealthCollection"
    },
    {
      "$ref": "#/$defs/nationCollection"
    },
    {
      "$ref": "#/$defs/recordIndex"
    },
    {
      "$ref": "#/$defs/recordDetail"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "nullableDate": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableDateTime": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "name", "stateCode"],
      "properties": {
        "level": {
          "enum": ["federal", "state", "county", "tribal", "other"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stateCode": {
          "oneOf": [
            {
              "enum": ["WA", "OR", "ID"]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "schemaVersion",
        "artifactVersion",
        "buildId",
        "generatedAt",
        "dataAsOf",
        "synthetic",
        "recordSchemaVersion",
        "taxonomyVersion",
        "sourceRegistryVersion",
        "recordCount",
        "nationCount",
        "assets"
      ],
      "properties": {
        "artifactType": {
          "const": "manifest"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "artifactVersion": {
          "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0"]
        },
        "buildId": {
          "type": "string",
          "pattern": "^synthetic-[a-f0-9]{20}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "dataAsOf": {
          "type": "string",
          "format": "date-time"
        },
        "synthetic": {
          "type": "boolean"
        },
        "recordSchemaVersion": {
          "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0"]
        },
        "taxonomyVersion": {
          "const": "1.0.0"
        },
        "sourceRegistryVersion": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0",
            "1.4.0",
            "1.5.0",
            "1.6.0",
            "1.7.0",
            "1.8.0",
            "1.9.0",
            "1.10.0",
            "1.11.0",
            "1.12.0",
            "1.13.0",
            "1.14.0",
            "1.15.0",
            "1.16.0",
            "1.17.0",
            "1.18.0",
            "1.19.0"
          ]
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "nationCount": {
          "const": 575
        },
        "assets": {
          "type": "array",
          "minItems": 5,
          "maxItems": 20000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "sizeBytes",
              "mediaType",
              "sourceIds"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:coverage|source-health|nations|taxonomy)\\.json$|^index/records\\.json$|^details/[A-Za-z0-9_-]+\\.json$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              },
              "mediaType": {
                "const": "application/json"
              },
              "sourceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/slug"
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "schemaVersion",
        "generatedAt",
        "notices",
        "entries"
      ],
      "properties": {
        "artifactType": {
          "const": "coverage"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "jurisdiction",
              "from",
              "through",
              "cadence",
              "recordTypes",
              "status",
              "limitation"
            ],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/slug"
              },
              "sourceName": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "jurisdiction": {
                "$ref": "#/$defs/jurisdiction"
              },
              "from": {
                "$ref": "#/$defs/nullableDate"
              },
              "through": {
                "$ref": "#/$defs/nullableDate"
              },
              "documentedFrom": {
                "$ref": "#/$defs/nullableDate"
              },
              "documentedThrough": {
                "$ref": "#/$defs/nullableDate"
              },
              "recordFrom": {
                "$ref": "#/$defs/nullableDate"
              },
              "recordThrough": {
                "$ref": "#/$defs/nullableDate"
              },
              "recordCount": {
                "type": "integer",
                "minimum": 0
              },
              "cadence": {
                "type": "string",
                "minLength": 1
              },
              "recordTypes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": ["synthetic", "available", "limited", "unavailable"]
              },
              "limitation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sourceHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceName",
        "status",
        "checkedAt",
        "dataAsOf",
        "lastSuccessfulRetrievalAt",
        "usingLastKnownGood",
        "stale",
        "recordCount",
        "failureStage",
        "message"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/slug"
        },
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["healthy", "degraded", "failed", "unavailable", "unknown"]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "dataAsOf": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "lastSuccessfulRetrievalAt": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "usingLastKnownGood": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "failureStage": {
          "oneOf": [
            {
              "enum": [
                "contract",
                "discovery",
                "fetch",
                "normalize",
                "validation",
                "packaging"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": ["string", "null"]
        }
      }
    },
    "sourceHealthCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "schemaVersion", "generatedAt", "sources"],
      "properties": {
        "artifactType": {
          "const": "source-health"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceHealth"
          }
        }
      }
    },
    "nation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "officialName",
        "authorizedAliases",
        "recognitionBaselineVersion",
        "stateCoverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^nation:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "officialName": {
          "type": "string",
          "minLength": 1
        },
        "authorizedAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recognitionBaselineVersion": {
          "type": "string",
          "minLength": 1
        },
        "stateCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["states", "federalOnly", "basis"],
          "allOf": [
            {
              "if": {
                "properties": {
                  "basis": {
                    "const": "reviewed_official_crosswalk"
                  }
                }
              },
              "then": {
                "required": ["evidence"],
                "properties": {
                  "states": {
                    "type": "array",
                    "minItems": 1
                  },
                  "federalOnly": {
                    "const": false
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "basis": {
                    "const": "unresolved_no_reviewed_crosswalk"
                  }
                }
              },
              "then": {
                "properties": {
                  "states": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "federalOnly": {
                    "const": true
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "basis": {
                    "const": "synthetic_fixture"
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            }
          ],
          "properties": {
            "states": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": ["WA", "OR", "ID"]
              }
            },
            "federalOnly": {
              "type": "boolean"
            },
            "basis": {
              "enum": [
                "synthetic_fixture",
                "reviewed_official_crosswalk",
                "unresolved_no_reviewed_crosswalk"
              ]
            },
            "evidence": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "basis",
                  "sourceNationName",
                  "evidenceText",
                  "evidenceUrl",
                  "sourceIdentifier",
                  "sourceDate",
                  "retrievedAt",
                  "validationState"
                ],
                "properties": {
                  "state": {
                    "enum": ["WA", "OR", "ID"]
                  },
                  "basis": {
                    "const": "reviewed_official_crosswalk"
                  },
                  "sourceNationName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidenceText": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidenceUrl": {
                    "$ref": "#/$defs/httpsUrl"
                  },
                  "sourceIdentifier": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceDate": {
                    "$ref": "#/$defs/nullableDate"
                  },
                  "retrievedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "validationState": {
                    "const": "validated"
                  }
                }
              }
            }
          }
        },
        "aliasProvenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alias",
              "basis",
              "evidenceText",
              "evidenceUrl",
              "retrievedAt",
              "validationState"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "const": "official_cross_reference"
              },
              "evidenceText": {
                "type": "string",
                "minLength": 1
              },
              "evidenceUrl": {
                "$ref": "#/$defs/httpsUrl"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              },
              "validationState": {
                "const": "validated"
              }
            }
          }
        },
        "sourceIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "officialListEntry": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "enum": ["contiguous_48", "alaska"]
        },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exactText",
              "paragraphId",
              "page",
              "section",
              "sourceUrl",
              "officialTextUrl",
              "officialPdfUrl"
            ],
            "properties": {
              "exactText": {
                "type": "string",
                "minLength": 1
              },
              "paragraphId": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": ["string", "null"]
              },
              "section": {
                "enum": ["contiguous_48", "alaska"]
              },
              "sourceUrl": {
                "$ref": "#/$defs/httpsUrl"
              },
              "officialTextUrl": {
                "$ref": "#/$defs/httpsUrl"
              },
              "officialPdfUrl": {
                "$ref": "#/$defs/httpsUrl"
              }
            }
          }
        },
        "fieldProvenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "sourceUrl",
              "sourceDate",
              "retrievedAt",
              "transformation",
              "transformRuleId",
              "validationState"
            ],
            "properties": {
              "field": {
                "enum": [
                  "/id",
                  "/officialName",
                  "/authorizedAliases",
                  "/recognitionBaselineVersion",
                  "/stateCoverage",
                  "/sourceIdentifier",
                  "/officialListEntry",
                  "/section",
                  "/sourceEvidence"
                ]
              },
              "sourceUrl": {
                "$ref": "#/$defs/httpsUrl"
              },
              "sourceDate": {
                "type": "string",
                "format": "date"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              },
              "transformation": {
                "enum": [
                  "copied",
                  "deterministic_mapping",
                  "reconciled_official_cross_reference",
                  "combined"
                ]
              },
              "transformRuleId": {
                "type": ["string", "null"]
              },
              "validationState": {
                "const": "validated"
              }
            }
          }
        }
      }
    },
    "nationCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "schemaVersion",
        "generatedAt",
        "baseline",
        "nations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "baseline": {
                "type": "object",
                "required": ["synthetic"],
                "properties": {
                  "synthetic": {
                    "const": false
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "registryVersion",
              "identityRule",
              "publicationReview",
              "validation",
              "sourceHealth"
            ],
            "properties": {
              "baseline": {
                "type": "object",
                "required": [
                  "documentNumber",
                  "publicationDate",
                  "officialTextUrl",
                  "officialPdfUrl",
                  "structuredTranscriptionUrl"
                ],
                "properties": {
                  "documentNumber": {},
                  "publicationDate": {},
                  "officialTextUrl": {},
                  "officialPdfUrl": {},
                  "structuredTranscriptionUrl": {}
                }
              },
              "registryVersion": {},
              "identityRule": {},
              "publicationReview": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "completed"
                  },
                  "blocking": {
                    "const": false
                  },
                  "reviewedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "nations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "aliasProvenance",
                    "sourceIdentifier",
                    "officialListEntry",
                    "section",
                    "sourceEvidence",
                    "fieldProvenance"
                  ],
                  "properties": {
                    "aliasProvenance": {},
                    "sourceIdentifier": {},
                    "officialListEntry": {},
                    "section": {},
                    "sourceEvidence": {},
                    "fieldProvenance": {},
                    "stateCoverage": {
                      "type": "object",
                      "properties": {
                        "basis": {
                          "enum": [
                            "reviewed_official_crosswalk",
                            "unresolved_no_reviewed_crosswalk"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "validation": {},
              "sourceHealth": {}
            }
          },
          "else": {
            "properties": {
              "nations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "stateCoverage": {
                      "type": "object",
                      "properties": {
                        "basis": {
                          "const": "synthetic_fixture"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "artifactType": {
          "const": "nation-collection"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "registryVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "version",
            "authorityName",
            "authorityUrl",
            "synthetic"
          ],
          "properties": {
            "count": {
              "const": 575
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "authorityName": {
              "type": "string",
              "minLength": 1
            },
            "authorityUrl": {
              "$ref": "#/$defs/httpsUrl"
            },
            "synthetic": {
              "type": "boolean"
            },
            "documentNumber": {
              "type": "string",
              "minLength": 1
            },
            "publicationDate": {
              "type": "string",
              "format": "date"
            },
            "officialTextUrl": {
              "$ref": "#/$defs/httpsUrl"
            },
            "officialPdfUrl": {
              "$ref": "#/$defs/httpsUrl"
            },
            "structuredTranscriptionUrl": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        },
        "nations": {
          "type": "array",
          "minItems": 575,
          "maxItems": 575,
          "items": {
            "$ref": "#/$defs/nation"
          }
        },
        "identityRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "description"],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "publicationReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "blocking", "reasonCode", "note", "reviewedAt"],
          "properties": {
            "state": {
              "enum": ["required_before_publication", "completed"]
            },
            "blocking": {
              "type": "boolean"
            },
            "reasonCode": {
              "$ref": "#/$defs/slug"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "reviewedAt": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "rawEntryCount",
            "reconciledNationCount",
            "uniqueIdCount",
            "uniqueOfficialNameCount",
            "transcriptCompared",
            "reconciliationRuleIds"
          ],
          "properties": {
            "state": {
              "const": "validated"
            },
            "rawEntryCount": {
              "type": "integer",
              "minimum": 575
            },
            "reconciledNationCount": {
              "const": 575
            },
            "uniqueIdCount": {
              "const": 575
            },
            "uniqueOfficialNameCount": {
              "const": 575
            },
            "transcriptCompared": {
              "const": true
            },
            "reconciliationRuleIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/slug"
              }
            }
          }
        },
        "sourceHealth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checkedAt",
            "dataAsOf",
            "lastSuccessfulRetrievalAt",
            "usingLastKnownGood",
            "message"
          ],
          "properties": {
            "status": {
              "const": "healthy"
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time"
            },
            "dataAsOf": {
              "type": "string",
              "format": "date"
            },
            "lastSuccessfulRetrievalAt": {
              "type": "string",
              "format": "date-time"
            },
            "usingLastKnownGood": {
              "const": false
            },
            "message": {
              "type": "null"
            }
          }
        }
      }
    },
    "indexJurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "name", "stateCode", "generalJurisdictionOnly"],
      "properties": {
        "level": {
          "enum": ["federal", "state", "county", "tribal", "other"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stateCode": {
          "oneOf": [
            {
              "enum": ["WA", "OR", "ID"]
            },
            {
              "type": "null"
            }
          ]
        },
        "generalJurisdictionOnly": {
          "type": "boolean"
        }
      }
    },
    "indexJudicialContext": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adjudicatingBody",
            "docketNumbers",
            "citations",
            "decisionDate",
            "documentForm",
            "publicationStatus",
            "revisionReview"
          ],
          "properties": {
            "adjudicatingBody": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sourceId", "officialName"],
              "properties": {
                "kind": {
                  "enum": ["court", "administrative_body"]
                },
                "sourceId": {
                  "type": ["string", "null"]
                },
                "officialName": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "docketNumbers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "citations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value", "sourceUrl"],
                "properties": {
                  "kind": {
                    "enum": ["reporter", "neutral", "official_other"]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceUrl": {
                    "$ref": "#/$defs/httpsUrl"
                  }
                }
              }
            },
            "decisionDate": {
              "type": "string",
              "format": "date"
            },
            "documentForm": {
              "type": "object",
              "additionalProperties": false,
              "required": ["normalized", "sourceLabel"],
              "properties": {
                "normalized": {
                  "enum": [
                    "opinion",
                    "order",
                    "judgment",
                    "memorandum",
                    "decision",
                    "other"
                  ]
                },
                "sourceLabel": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "publicationStatus": {
              "type": "object",
              "additionalProperties": false,
              "required": ["normalized", "sourceLabel", "asOf"],
              "properties": {
                "normalized": {
                  "enum": [
                    "slip_opinion",
                    "amended",
                    "withdrawn",
                    "preliminary_print",
                    "bound_volume",
                    "final",
                    "published",
                    "unpublished",
                    "unknown"
                  ]
                },
                "sourceLabel": {
                  "type": "string",
                  "minLength": 1
                },
                "asOf": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "revisionReview": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "reviewedOn"],
              "properties": {
                "state": {
                  "enum": [
                    "no_separate_relationship_exposed",
                    "relationships_recorded"
                  ]
                },
                "reviewedOn": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      ]
    },
    "indexAccordContext": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parties",
            "executionEvent",
            "statusReview",
            "supersessionReview",
            "instrumentIdentity"
          ],
          "properties": {
            "parties": {
              "type": "array",
              "minItems": 2,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceId", "partyKind", "officialName", "roles"],
                "properties": {
                  "sourceId": {
                    "type": ["string", "null"]
                  },
                  "partyKind": {
                    "enum": ["government", "collective_governments"]
                  },
                  "officialName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "roles": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["normalized", "sourceLabel", "sourceUrl"],
                      "properties": {
                        "normalized": {
                          "enum": ["executing_party", "signatory_party"]
                        },
                        "sourceLabel": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sourceUrl": {
                          "$ref": "#/$defs/httpsUrl"
                        }
                      }
                    }
                  }
                }
              }
            },
            "executionEvent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "date", "sourceLabel", "sourceUrl"],
              "properties": {
                "role": {
                  "enum": ["executed", "signed"]
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "sourceLabel": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceUrl": {
                  "$ref": "#/$defs/httpsUrl"
                }
              }
            },
            "statusReview": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "currentStatus",
                "evidenceKind",
                "sourceLabel",
                "sourceUrl",
                "reviewedOn"
              ],
              "properties": {
                "currentStatus": {
                  "const": "not_established"
                },
                "evidenceKind": {
                  "const": "narrative_execution_language"
                },
                "sourceLabel": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceUrl": {
                  "$ref": "#/$defs/httpsUrl"
                },
                "reviewedOn": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "supersessionReview": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "scope", "reviewedOn", "sourceUrls"],
              "properties": {
                "state": {
                  "enum": [
                    "no_relationship_established",
                    "relationships_recorded"
                  ]
                },
                "scope": {
                  "const": "reviewed_official_sources_only"
                },
                "reviewedOn": {
                  "type": "string",
                  "format": "date"
                },
                "sourceUrls": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/httpsUrl"
                  }
                }
              }
            },
            "instrumentIdentity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sourceIdentifier", "fallbackRuleId"],
              "properties": {
                "kind": {
                  "enum": ["source_provided", "project_fallback"]
                },
                "sourceIdentifier": {
                  "type": ["string", "null"],
                  "minLength": 1
                },
                "fallbackRuleId": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/slug"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "source_provided"
                      }
                    },
                    "required": ["kind"]
                  },
                  "then": {
                    "properties": {
                      "sourceIdentifier": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fallbackRuleId": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "sourceIdentifier": {
                        "type": "null"
                      },
                      "fallbackRuleId": {
                        "$ref": "#/$defs/slug"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "recordIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "detailPath",
        "officialTitle",
        "documentType",
        "jurisdiction",
        "status",
        "source",
        "dates",
        "taxonomyMemberships",
        "isUnclassified",
        "nationIds",
        "relevance",
        "landmark",
        "change"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^psr:"
        },
        "detailPath": {
          "type": "string",
          "pattern": "^details/[A-Za-z0-9_-]+\\.json$"
        },
        "sourceDocumentIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "officialTitle": {
          "type": "string",
          "minLength": 1
        },
        "documentType": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "$ref": "#/$defs/indexJurisdiction"
        },
        "issuingBodies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "judicialContext": {
          "$ref": "#/$defs/indexJudicialContext"
        },
        "accordContext": {
          "$ref": "#/$defs/indexAccordContext"
        },
        "status": {
          "type": "object"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "provider"],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dates": {
          "type": "object"
        },
        "urls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["officialSource"],
          "properties": {
            "officialSource": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        },
        "taxonomyMemberships": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["categoryId", "subcategoryId"],
            "properties": {
              "categoryId": {
                "$ref": "#/$defs/slug"
              },
              "subcategoryId": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/slug"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "isUnclassified": {
          "type": "boolean"
        },
        "nationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^nation:"
          }
        },
        "relevance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "landmark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["isLandmark"],
          "properties": {
            "isLandmark": {
              "type": "boolean"
            }
          }
        },
        "change": {
          "type": "object"
        }
      }
    },
    "recordIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "schemaVersion", "generatedAt", "records"],
      "properties": {
        "artifactType": {
          "const": "record-index"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recordIndexEntry"
          }
        }
      }
    },
    "recordDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "schemaVersion", "generatedAt", "record"],
      "properties": {
        "artifactType": {
          "const": "record-detail"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "record": {
          "type": "object"
        }
      }
    }
  }
}
